# ============================================================================
# my-first-project 环境变量模板
# 复制此文件为 .env 并填入你的真实配置值
#   cp .env.example .env
# ============================================================================

# --- DeepSeek API（必填）---
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- 模型别名（可选，默认值见 config/config.yaml）---
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- 本地模型路径（可选，使用本地 Embedding/Reranker 时配置）---
# HF_HOME=D:/AI_Models/huggingface
# HF_HUB_OFFLINE=1

# --- 应用配置覆盖（可选，会覆盖 config.yaml 中的对应值）---
# ENV_APP_NAME=my-project-overlay
# ENV_SERVER_PORT=9090
# ENV_LOGGING_LEVEL=DEBUG

# --- 其他 ---
MY_NAME=Python_Learner
